use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests

excludePaths:
	- tests/**/output
	- fixtures*

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations

	- # the wrappers implement the streamWrapper interface, whose method names PHP prescribes
		paths: [src/MutatingWrapper.php, src/NativeWrapper.php]
		naming: {method: keep}
